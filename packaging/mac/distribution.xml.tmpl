<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>慧眼选鸟 SuperPicky</title>
    <organization>com.jamesphotography</organization>
    <domains enable_localSystem="true"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>

    <welcome file="welcome.html" mime-type="text/html"/>
    <license file="LICENSE" mime-type="text/plain"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>

    <choices-outline>
        <line choice="default">
            <line choice="__BUNDLE_ID__"/>
        </line>
    </choices-outline>

    <choice id="default"/>
    <choice id="__BUNDLE_ID__" visible="false">
        <pkg-ref id="__BUNDLE_ID__"/>
    </choice>

    <pkg-ref id="__BUNDLE_ID__" version="__VERSION__" onConclusion="none">
        __COMPONENT_PKG__
    </pkg-ref>
</installer-gui-script>
